{
  "name": "zenstate",
  "version": "5.8.4",
  "description": "ZenState - Everything Flow",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm run dev:renderer\" \"npm run dev:main:watch\" \"sleep 3 && electron .\"",
    "dev:renderer": "vite",
    "dev:main:watch": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test:allocations": "tsc src/main/services/weeklyAllocations.ts src/shared/weeklyAllocations.ts --outDir .test-weekly --rootDir src --module commonjs --target es2022 --skipLibCheck --strict && node --test tests/weekly-allocations.test.cjs",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage --x64 --publish never",
    "test": "npm run build:main && npm run test:allocations && node --test tests/release-safety.test.cjs tests/release-artifacts.test.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "release:check": "npm test && tsc --noEmit -p tsconfig.json && node scripts/verify-release.cjs --complete --stable"
  },
  "author": "ZenState",
  "license": "PROPRIETARY",
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bonjour-service": "^1.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.zenstate.app",
    "productName": "ZenState",
    "publish": {
      "provider": "github",
      "owner": "Everything-Design",
      "repo": "ZenState"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "ZenState-${version}-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/wifi-info",
          "to": "wifi-info",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extendInfo": {
        "NSLocationUsageDescription": "ZenState uses your location to identify which WiFi access point you are connected to.",
        "NSLocationWhenInUseUsageDescription": "ZenState uses your location to identify which WiFi access point you are connected to.",
        "NSLocalNetworkUsageDescription": "ZenState discovers teammates on your local network for presence and meeting requests.",
        "NSBonjourServices": [
          "_zenstate._tcp"
        ]
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZenState-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "license": "build/license.rtf"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "ZenState",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZenState-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "appImage": {
      "executableArgs": []
    }
  },
  "homepage": "https://github.com/Everything-Design/ZenState",
  "desktopName": "zenstate.desktop"
}
